# URL base de la API de tasa de cambio (pública, sin clave secreta).
# Proveedor principal por defecto: ve.dolarapi.com (tasa oficial BCV para Venezuela).
# La app cuenta ademas con respaldo automatico a rates.dolarvzla.com, bcv.justcarlux.dev y bcv.today.
VITE_EXCHANGE_RATE_API_URL=https://ve.dolarapi.com/v1/dolares/oficial

# Si el proveedor elegido exige una clave publica (no secreta), colocarla aqui.
# IMPORTANTE: cualquier variable VITE_* queda expuesta en el bundle del navegador.
# NUNCA coloque aqui una clave secreta/privada. Si el proveedor de tasa exige
# una clave que deba permanecer oculta, se necesita un pequeno proxy/servidor
# intermedio; esta app, al ser 100% frontend, no puede ocultar secretos.
VITE_EXCHANGE_RATE_API_KEY=

# Frecuencia de actualizacion automatica de la tasa, en minutos (por defecto 5 min).
VITE_EXCHANGE_RATE_REFRESH_MINUTES=5

